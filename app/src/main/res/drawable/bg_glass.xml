<?xml version="1.0" encoding="utf-8"?>
<!-- Liquid-glass widget background: smoky translucent body, top sheen,
     bright specular rim on the top/left edges and a faint reflected rim bottom-right. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Body tint (keeps white text readable without real blur) -->
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="26dp" />
            <gradient
                android:angle="315"
                android:centerColor="#3D26262B"
                android:endColor="#4D1C1C20"
                android:startColor="#52303036" />
        </shape>
    </item>

    <!-- Top sheen -->
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="26dp" />
            <gradient
                android:angle="270"
                android:centerColor="#08FFFFFF"
                android:centerY="0.42"
                android:endColor="#12FFFFFF"
                android:startColor="#3DFFFFFF"
                android:type="linear" />
        </shape>
    </item>

    <!-- Outer rim -->
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="26dp" />
            <stroke
                android:width="1dp"
                android:color="#4DFFFFFF" />
        </shape>
    </item>

    <!-- Inner rim -->
    <item
        android:bottom="1dp"
        android:left="1dp"
        android:right="1dp"
        android:top="1dp">
        <shape android:shape="rectangle">
            <corners android:radius="25dp" />
            <stroke
                android:width="1dp"
                android:color="#17FFFFFF" />
        </shape>
    </item>

    <!-- Specular highlight along the top edge -->
    <item
        android:height="1.2dp"
        android:gravity="top|fill_horizontal"
        android:left="24dp"
        android:right="24dp">
        <shape android:shape="rectangle">
            <gradient
                android:angle="0"
                android:centerColor="#E6FFFFFF"
                android:centerX="0.3"
                android:endColor="#1AFFFFFF"
                android:startColor="#33FFFFFF" />
        </shape>
    </item>

    <!-- Highlight down the left edge -->
    <item
        android:bottom="24dp"
        android:gravity="left|fill_vertical"
        android:top="24dp"
        android:width="1.2dp">
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:endColor="#00FFFFFF"
                android:startColor="#A6FFFFFF" />
        </shape>
    </item>

    <!-- Reflected light, bottom edge -->
    <item
        android:height="1dp"
        android:gravity="bottom|fill_horizontal"
        android:left="24dp"
        android:right="24dp">
        <shape android:shape="rectangle">
            <gradient
                android:angle="0"
                android:centerColor="#14FFFFFF"
                android:centerX="0.6"
                android:endColor="#73FFFFFF"
                android:startColor="#00FFFFFF" />
        </shape>
    </item>

    <!-- Reflected light, right edge -->
    <item
        android:bottom="24dp"
        android:gravity="right|fill_vertical"
        android:top="24dp"
        android:width="1dp">
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:endColor="#59FFFFFF"
                android:startColor="#00FFFFFF" />
        </shape>
    </item>
</layer-list>
