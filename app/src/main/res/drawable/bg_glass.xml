<?xml version="1.0" encoding="utf-8"?>
<!-- Liquid-glass body: a smoky translucent tint only.
     The rim, inner glow and sheen are drawn in code (Charts.glass) so they follow
     the rounded corners continuously at the widget's real size. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <corners android:radius="26dp" />
    <gradient
        android:angle="315"
        android:endColor="#42202024"
        android:startColor="#4A2C2C32" />
</shape>
